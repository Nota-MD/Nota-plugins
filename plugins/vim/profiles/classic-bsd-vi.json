{
  "schema": 1,
  "id": "classic-bsd-vi",
  "label": "Classic BSD vi",
  "description": "POSIX/BSD vi modes, motions, operators and Ex commands without Vim extensions.",
  "sources": [
    "POSIX vi",
    "OpenBSD usr.bin/vi/vi/v_cmd.c"
  ],
  "features": {
    "compatible": true,
    "modes": {
      "normal": true,
      "insert": true,
      "replace": false,
      "ex": true,
      "visual": false,
      "visualLine": false,
      "visualBlock": false
    },
    "counts": true,
    "dotRepeat": true,
    "marks": true,
    "namedRegisters": true,
    "macroRecording": false,
    "textObjects": false,
    "multiLevelUndo": false,
    "undoLevels": 1,
    "redo": false,
    "arrowKeys": false,
    "mouse": false,
    "insertArrowKeys": false,
    "insertControlO": false,
    "commandLineEditing": false,
    "systemClipboardRegisters": false,
    "displayLineMotions": false,
    "flashJump": false,
    "insertBackspace": "joined",
    "joinSpaces": 2
  },
  "mappings": {
    "normal": {
      "h": "move.left",
      "j": "move.down",
      "k": "move.up",
      "l": "move.right",
      "<Space>": "move.right",
      "<C-h>": "move.left",
      "<C-j>": "move.down",
      "<C-n>": "move.down",
      "<C-p>": "move.up",
      "<CR>": "move.lineFirstNonBlank",
      "+": "move.lineFirstNonBlank",
      "-": "move.linePreviousFirstNonBlank",
      "w": "move.wordForward",
      "W": "move.bigWordForward",
      "b": "move.wordBack",
      "B": "move.bigWordBack",
      "e": "move.wordEnd",
      "E": "move.bigWordEnd",
      "0": "move.lineStart",
      "^": "move.lineFirstNonBlank",
      "_": "move.lineFirstNonBlank",
      "$": "move.lineEnd",
      "|": "move.column",
      "G": "move.documentLine",
      "H": "move.screenTop",
      "M": "move.screenMiddle",
      "L": "move.screenBottom",
      "(": "move.sentenceBack",
      ")": "move.sentenceForward",
      "{": "move.paragraphBack",
      "}": "move.paragraphForward",
      "[[": "move.sectionBack",
      "]]": "move.sectionForward",
      "%": "move.matchPair",
      "f": "motion.findForward",
      "F": "motion.findBack",
      "t": "motion.tillForward",
      "T": "motion.tillBack",
      ";": "motion.repeatFind",
      ",": "motion.repeatFindReverse",
      "<C-b>": "scroll.pageBack",
      "<C-f>": "scroll.pageForward",
      "<C-u>": "scroll.halfPageBack",
      "<C-d>": "scroll.halfPageForward",
      "<C-y>": "scroll.lineBack",
      "<C-e>": "scroll.lineForward",
      "/": "search.forward",
      "?": "search.backward",
      "n": "search.next",
      "N": "search.previous",
      "<C-a>": "search.wordForward",
      "*": false,
      "#": "edit.incrementNumber",
      "&": "ex.repeatSubstitute",
      "i": "mode.insertBefore",
      "a": "mode.insertAfter",
      "I": "mode.insertLineStart",
      "A": "mode.insertLineEnd",
      "o": "mode.openBelow",
      "O": "mode.openAbove",
      "R": "mode.replace",
      "r": "edit.replaceChar",
      "s": "edit.substitute",
      "S": "edit.substituteLine",
      "x": "edit.deleteChar",
      "X": "edit.deleteCharBack",
      "d": "operator.delete",
      "c": "operator.change",
      "y": "operator.yank",
      "D": "edit.deleteToLineEnd",
      "C": "edit.changeToLineEnd",
      "Y": "edit.yankLine",
      "p": "paste.after",
      "P": "paste.before",
      "J": "edit.join",
      ">": "operator.shiftRight",
      "<": "operator.shiftLeft",
      "!": "operator.filter",
      "u": "history.undo",
      "U": "history.restoreLine",
      ".": "edit.repeat",
      "~": "edit.toggleCase",
      "@": "register.execute",
      "m": "mark.set",
      "'": "mark.goLine",
      "`": "mark.goExact",
      ":": "ex.start",
      "Q": "ex.start",
      "<C-\\>": "ex.start",
      "ZZ": "ex.writeQuit",
      "z": "screen.position",
      "<C-l>": "screen.redraw",
      "<C-r>": "screen.redraw",
      "<C-g>": "status.show",
      "<C-w>": "screen.next",
      "<C-]>": "tag.push",
      "<C-t>": "tag.pop",
      "<C-^>": "buffer.alternate"
    },
    "insert": {
      "<Esc>": "mode.normal",
      "<C-[>": "mode.normal",
      "<C-v>": "insert.literalNext",
      "<C-w>": "insert.deleteWordBack",
      "<C-h>": "insert.deleteCharBack",
      "<Backspace>": "insert.deleteCharBack",
      "<C-u>": "insert.deleteToLineStart",
      "<C-d>": "insert.unindent",
      "<C-t>": "insert.indent",
      "<CR>": "insert.newline"
    }
  }
}
