{
  "schema": 1,
  "id": "modern-vim",
  "label": "Modern Vim",
  "description": "Vim 9 compatible mode with visual selections, text objects, redo, macros and insert-mode navigation.",
  "extends": "classic-bsd-vi",
  "sources": [
    "Vim 9.2 :help vi-differences",
    "Vim 9.2 :help visual-mode",
    "Vim 9.2 :help text-objects"
  ],
  "features": {
    "compatible": false,
    "modes": {
      "visual": true,
      "visualLine": true,
      "visualBlock": false
    },
    "macroRecording": true,
    "textObjects": true,
    "multiLevelUndo": true,
    "undoLevels": 1000,
    "redo": true,
    "arrowKeys": true,
    "mouse": true,
    "insertArrowKeys": true,
    "insertControlO": false,
    "commandLineEditing": true,
    "systemClipboardRegisters": false,
    "displayLineMotions": false,
    "flashJump": false,
    "insertBackspace": "indent,eol,start",
    "joinSpaces": 2
  },
  "mappings": {
    "normal": {
      "<Left>": "move.left",
      "<Right>": "move.right",
      "<Up>": "move.up",
      "<Down>": "move.down",
      "<Home>": "move.lineStart",
      "<End>": "move.lineEnd",
      "gg": "move.documentStart",
      "gj": "move.displayDown",
      "gk": "move.displayUp",
      "g0": "move.displayLineStart",
      "g$": "move.displayLineEnd",
      "gm": "move.displayLineMiddle",
      "g_": "move.displayLineLastNonBlank",
      "ge": "move.wordEndBack",
      "gE": "move.bigWordEndBack",
      "gu": "operator.lowercase",
      "gU": "operator.uppercase",
      "g~": "operator.toggleCase",
      "gq": "operator.format",
      "gw": "operator.formatKeepCursor",
      "gJ": "edit.joinWithoutSpace",
      "gi": "mode.insertAtLastInsert",
      "gv": "visual.reselect",
      "v": "visual.char",
      "V": "visual.line",
      "<C-v>": "visual.block",
      "<C-q>": "visual.block",
      "<C-r>": "history.redo",
      "q": "macro.recordToggle",
      "@": "macro.execute",
      "@@": "macro.repeatLast",
      "<C-a>": "edit.incrementNumber",
      "<C-x>": "edit.decrementNumber",
      "<C-o>": "jump.back",
      "<Tab>": "jump.forward",
      "<C-i>": "jump.forward"
    },
    "insert": {
      "<Left>": "move.left",
      "<Right>": "move.right",
      "<Up>": "move.up",
      "<Down>": "move.down",
      "<Home>": "move.lineStart",
      "<End>": "move.lineEnd",
      "<C-o>": "insert.oneNormalCommand",
      "<C-r>": "insert.register",
      "<C-a>": "insert.lastInserted",
      "<C-@>": "insert.lastInserted",
      "<C-n>": "insert.completeNext",
      "<C-p>": "insert.completePrevious",
      "<C-w>": "insert.deleteWordBack",
      "<C-u>": "insert.deleteToLineStart"
    },
    "visual": {
      "<Esc>": "mode.normal",
      "<C-[>": "mode.normal",
      "v": "visual.toggle",
      "V": "visual.line",
      "<C-v>": "visual.block",
      "<C-q>": "visual.block",
      "o": "visual.swapEnds",
      "O": "visual.swapEnds",
      "d": "operator.delete",
      "x": "operator.delete",
      "c": "operator.change",
      "y": "operator.yank",
      ">": "operator.shiftRight",
      "<": "operator.shiftLeft",
      "~": "operator.toggleCase",
      "u": "operator.lowercase",
      "U": "operator.uppercase",
      "J": "edit.join",
      "gJ": "edit.joinWithoutSpace",
      ":": "ex.startRange"
    }
  }
}
